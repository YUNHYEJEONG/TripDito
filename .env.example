# ─────────────────────────────────────────────────────────────
# TripDito 로컬 환경변수 — 절대 커밋/공유 금지 (.gitignore: .env*)
# 키 이름만 있는 템플릿은 .env.example 참고
# ─────────────────────────────────────────────────────────────

# ── Google Maps (브라우저 노출 public 키 — HTTP 리퍼러 제한 권장)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── 한국수출입은행 현재환율 Open API (서버 전용)
KOREAEXIM_AUTH_KEY=

# ── Google Generative AI (Gemini 이미지 분석, 서버 전용)
GOOGLE_GENERATIVE_AI_API_KEY=
# 선택: 사진 분석 비전 모델 덮어쓰기 (기본 gemini-3.6-flash)
GEMINI_VISION_MODEL=

# ── NextAuth 세션 서명 시크릿 (openssl rand -base64 32 로 생성됨)
AUTH_SECRET=

# ── PostgreSQL (Neon)
DATABASE_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# ── Cloudflare R2 (S3 호환 오브젝트 스토리지 — 첨부파일 저장)

# R2 → Manage R2 API Tokens 에서 토큰 생성 후 Access Key / Secret 입력
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# 공개 읽기용 URL (버킷 Public access 활성화 시 r2.dev 도메인 또는 커스텀 도메인)
R2_PUBLIC_BASE_URL=

# ── 소셜 로그인 (구글 우선, 카카오·네이버 병행)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# ── 선택 (없으면 해당 기능만 폴백/비활성)
OPENAI_API_KEY=
SERPAPI_API_KEY=
IMGBB_API_KEY=

# ── 개발용 로그인 (소셜 키 발급 전 임시). 프로덕션에서는 비우거나 false
ENABLE_DEV_LOGIN=
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
